        loadMsg.Position = UDim2.new(0, 20, 0, 332)
        loadMsg.BackgroundTransparency = 1
        loadMsg.Text = "Iniciando..."
        loadMsg.TextColor3 = Color3.fromRGB(145, 125, 180)
        loadMsg.Font = Enum.Font.Gotham
