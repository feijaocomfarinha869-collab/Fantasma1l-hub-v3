-- Create sorted list of house names
local houseNames = {}
for name, _ in pairs(casas) do
    table.insert(houseNames, name)
end

table.sort(houseNames, function(a, b)
    local numA = tonumber(a:match("%d+")) or 0
    local numB = tonumber(b:match("%d+")) or 0
    return numA < numB
end)

